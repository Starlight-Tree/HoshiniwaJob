{
  "name": "hoshiniwajob-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "images:create-batch": "node --env-file-if-exists=scripts/generate-images/.env scripts/generate-images/create-batch.ts",
    "images:check-batch": "node --env-file-if-exists=scripts/generate-images/.env scripts/generate-images/check-batch.ts",
    "images:download-results": "node --env-file-if-exists=scripts/generate-images/.env scripts/generate-images/download-results.ts",
    "images:generate-single": "node --env-file-if-exists=scripts/generate-images/.env scripts/generate-images/generate-single.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "better-auth": "1.7.18",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@google/genai": "^2.31.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
