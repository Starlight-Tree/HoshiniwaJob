{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./backups/**)",
      "Read(./_legacy/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "mcp__cloudflare__execute",
      "mcp__github__actions_run_trigger",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload",
      "mcp__prisma__create_*",
      "mcp__prisma__delete_*",
      "mcp__prisma__execute_*",
      "mcp__prisma__promote_prisma_compute_deployment",
      "mcp__prisma__rollback_prisma_compute_app",
      "mcp__prisma__set_prisma_compute_env_var",
      "mcp__prisma__start_prisma_compute_deployment",
      "mcp__prisma__stop_prisma_compute_deployment",
      "mcp__prisma__link_prisma_github_repository",
      "mcp__langsmith__commit_context_hub_directory",
      "mcp__langsmith__create_insights_job_configuration",
      "mcp__langsmith__create_model_price_map",
      "mcp__langsmith__delete_model_price_map",
      "mcp__langsmith__delete_prompt",
      "mcp__langsmith__push_prompt",
      "mcp__langsmith__run_insights_job_from_configuration",
      "mcp__langsmith__tag_prompt_commit",
      "mcp__langsmith__update_model_price_map",
      "mcp__langsmith__update_prompt",
      "mcp__langsmith__sandbox_batch_delete",
      "mcp__langsmith__sandbox_control",
      "mcp__langsmith__sandbox_exec_stream",
      "mcp__langsmith__sandbox_run",
      "mcp__langsmith__sandbox_service_url",
      "mcp__langsmith__sandbox_snapshot_control",
      "mcp__langsmith__sandbox_write_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cloud-cli.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-write.py"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-rules.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
