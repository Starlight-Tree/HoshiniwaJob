# 環境変数の見本。実際の値は .env（Git 管理外）に書く。
# 値をチャット・ログ・Git・スクリーンショットに出さない。

# --- 画像の保存先（Cloudflare R2）。詳しくは docs/image-storage.md ---
# R2 に接続するときの 4 つ。書かなければ、今までどおりフォルダーに保存する。
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_BUCKET=hoshiniwa-images
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# 画像を R2 から配信する切り替え。既存の画像の移行と確認が終わるまで、コメントのままにする。
# STORAGE_BACKEND=s3
# IMAGE_PUBLIC_BASE_URL=https://<r2.dev または独自ドメイン>
